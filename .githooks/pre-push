#!/usr/bin/env bash
#
# Local gate, run before every `git push`. Deliberately a git hook rather than a
# CI workflow: this project keeps GitHub Actions usage to a minimum, so the
# checks live on the machine doing the pushing.
#
# Installed automatically by `npm install` (the "prepare" script points
# core.hooksPath at this directory). To install by hand:
#     git config core.hooksPath .githooks
#
# To push past a failure (do this knowingly, not habitually):
#     git push --no-verify

set -uo pipefail

# Nothing to check if dependencies were never installed.
if [ ! -d node_modules ]; then
  echo "pre-push: node_modules is missing, run 'npm install' first." >&2
  exit 1
fi

fail=0

echo "pre-push: type check"
if ! npx --no-install tsc --noEmit; then
  echo "pre-push: FAILED type check" >&2
  fail=1
fi

echo "pre-push: unit tests"
if ! npx --no-install vitest run --silent; then
  echo "pre-push: FAILED unit tests" >&2
  fail=1
fi

# The extension ships as a build artifact, so a broken build is a broken
# release. Both Vite passes must succeed.
echo "pre-push: production build"
if ! npm run build --silent > /dev/null 2>&1; then
  echo "pre-push: FAILED production build (run 'npm run build' to see why)" >&2
  fail=1
fi

# Dependency audit. The shipped extension only depends on react and react-dom,
# so a production-scope finding is both rare and worth stopping for. Dev-only
# findings (Vite's dev server, mostly) are reported but do not block: they are
# frequent, often unfixable the same day, and do not reach users.
#
# A failure that is not a vulnerability (no network, registry down) must not
# block a push, so only an actual "vulnerabilities" verdict counts.
echo "pre-push: dependency audit (production scope)"
audit_out=$(npm audit --omit=dev --audit-level=high 2>&1 || true)
# Order matters: "found 0 vulnerabilities" also contains a digit followed by
# "vulnerabilit", so the clean case has to be recognised first.
if printf '%s' "$audit_out" | grep -q "found 0 vulnerabilities"; then
  echo "pre-push: no production advisories"
elif printf '%s' "$audit_out" | grep -qE '[1-9][0-9]* vulnerabilit'; then
  printf '%s\n' "$audit_out" | tail -20 >&2
  echo "pre-push: FAILED dependency audit (production dependencies)" >&2
  fail=1
else
  echo "pre-push: audit inconclusive (offline?), continuing" >&2
fi

dev_audit=$(npm audit --audit-level=high 2>&1 || true)
if ! printf '%s' "$dev_audit" | grep -q "found 0 vulnerabilities"; then
  dev_line=$(printf '%s\n' "$dev_audit" | grep -E '^[1-9][0-9]* vulnerabilit' || true)
  if [ -n "$dev_line" ]; then
    echo "pre-push: note, dev-only advisories present, not blocking: $dev_line" >&2
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: blocked. Fix the above, or push with --no-verify if you mean to." >&2
  exit 1
fi

echo "pre-push: all checks passed"
exit 0
